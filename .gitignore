/.ollama/
/ollama_models/
/models/*
!/models/config.json

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Flutter/Dart build output
.dart_tool/
build/

# Node.js dependencies
node_modules/
